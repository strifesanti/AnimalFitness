# Configuración de formato compartida por todo el repositorio.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Las migraciones de EF Core las genera la herramienta; no se editan a mano.
[**/Persistence/Migrations/*.cs]
generated_code = true

[*.{cs,csx,vb}]
indent_size = 4
dotnet_sort_system_directives_first = true
csharp_style_namespace_declarations = file_scoped:warning
csharp_new_line_before_open_brace = all
csharp_indent_labels = one_less_than_current

[*.{ts,tsx,js,jsx,mjs,cjs}]
indent_size = 2
quote_type = double

[*.{csproj,props,targets,slnx}]
indent_size = 2

[*.sln]
indent_style = tab

[*.{yml,yaml}]
indent_size = 2

[Dockerfile*]
indent_size = 4
