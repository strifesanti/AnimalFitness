# Copia este archivo a .env y ajusta los valores.
# Nunca subas .env al repositorio.

# --- Docker Compose / SQL Server ---
MSSQL_SA_PASSWORD=AnimalFitness_Dev1!

# --- API (local sin Docker o variables Compose) ---
ConnectionStrings__AnimalFitness=Server=localhost,1433;Database=AnimalFitness;User Id=sa;Password=AnimalFitness_Dev1!;TrustServerCertificate=True;Encrypt=False
Database__Provider=SqlServer

# SuperAdmin de Development (obligatorio para el seeder)
SEED_SUPERADMIN_EMAIL=superadmin@animalfitness.local
SEED_SUPERADMIN_PASSWORD=SuperAdmin_Dev1!
Seed__SuperAdmin__Email=superadmin@animalfitness.local
Seed__SuperAdmin__Password=SuperAdmin_Dev1!
Seed__SuperAdmin__FirstName=Super
Seed__SuperAdmin__LastName=Admin
Seed__Enabled=true

# --- Frontend ---
API_ORIGIN=http://localhost:5080
